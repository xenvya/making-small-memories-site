{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "making-small-memories-concepts",
  "account_id": "e84c719847d85d55e25931925c7c4703",
  "main": "worker/main.mjs",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "makingsmallmemories.com",
      "zone_id": "81068587767e3cb99e0204aeb3b51d4d",
      "custom_domain": true,
    },
    {
      "pattern": "www.makingsmallmemories.com",
      "zone_id": "81068587767e3cb99e0204aeb3b51d4d",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "observability": { "enabled": true, "traces": { "enabled": true } },
}
