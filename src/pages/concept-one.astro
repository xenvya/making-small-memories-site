---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Art from "../components/Art.astro";
import Arrow from "../components/Arrow.astro";
import Services from "../components/Services.astro";
import SharedSections from "../components/SharedSections.astro";
import { business } from "../data/business";
import "@fontsource/cormorant-garamond/latin-400.css";
import "@fontsource/cormorant-garamond/latin-400-italic.css";
import "../styles/keepsake.css";
---

<Base title="The Keepsake" theme="keepsake">
  <Header theme="keepsake" />
  <main id="main">
    <section class="keepsake-hero wrap">
      <div class="hero-copy">
        <span class="eyebrow">For the moments that become your life</span>
        <h1>
          A life well lived.
          <br />A moment
          <br />
          <em>well kept.</em>
        </h1>
        <p>
          Thoughtful guidance for where you’re going.
          <br class="desktop-break" /> More room for what you’ll remember.
        </p>
        <a class="button" href="#booking">
          Start a conversation <Arrow />
        </a>
        <a class="hero-secondary" href="#services">
          Discover how we can help <span aria-hidden="true">↓</span>
        </a>
      </div>
      <div class="keepsake-art">
        <div class="art-caption">The people at the heart of it all</div>
        <figure class="keepsake-print portrait-print">
          <img
            src="/images/john-and-wife.webp"
            srcset="/images/john-and-wife-small.webp 600w, /images/john-and-wife.webp 1118w"
            sizes="(max-width:700px) 85vw, 40vw"
            width="1118"
            height="1118"
            alt={`${business.contact} and ${business.partner}, smiling together in formal attire`}
            fetchpriority="high"
          />
          <figcaption>{business.couple} · A moment, together.</figcaption>
        </figure>
        <div class="memory-note">
          <span class="eyebrow">A note to self</span>
          <p>
            Make time
            <br />
            for the life
            <br />
            <em>you’re living.</em>
          </p>
          <span class="note-rule"></span>
          <small>One small memory at a time.</small>
        </div>
        <span class="art-bottom">Connection. Joy. Intention.</span>
      </div>
    </section>
    <div class="audience-strip wrap">
      <span>Here for life’s next chapter.</span>
      <p>
        Veterans & military <span aria-hidden="true">✳</span> Individuals &
        families <span aria-hidden="true">✳</span> Retirement & beyond
      </p>
    </div>
    <section class="keepsake-about section wrap" id="about">
      <div>
        <span class="eyebrow">The heart of Making Small Memories</span>
        <Art kind="flower" class="small-flower" />
      </div>
      <div>
        <h2>
          Life is made of moments.
          <br />
          <em>Let’s make them matter.</em>
        </h2>
        <p class="lead">{business.vision}</p>
        <p>{business.mission}</p>
        <p>{business.about}</p>
        <a class="text-link" href="#booking">
          Meet your next step with John <Arrow />
        </a>
      </div>
    </section>
    <Services theme="keepsake" />
    <section class="keepsake-pause">
      <span class="eyebrow">Our belief</span>
      <p>
        “The little moments become
        <br />
        the stories we remember most.”
      </p>
      <span>— From our mission</span>
    </section>
    <SharedSections theme="keepsake" />
  </main>
</Base>
