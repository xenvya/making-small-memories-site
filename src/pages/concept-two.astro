---
import Portrait from "../components/Portrait.astro";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Arrow from "../components/Arrow.astro";
import Services from "../components/Services.astro";
import SharedSections from "../components/SharedSections.astro";
import { business } from "../data/business";
import "@fontsource/manrope/latin-400.css";
import "@fontsource/manrope/latin-600.css";
import "@fontsource/manrope/latin-800.css";
import "../styles/horizon.css";
---

<Base title="Open Horizon" theme="horizon">
  <Header theme="horizon" />
  <main id="main">
    <section class="horizon-hero">
      <div class="wrap horizon-top">
        <span class="eyebrow">Life is still unfolding.</span>
        <h1>
          There’s more
          <br />
          life <span>out there.</span>
        </h1>
        <div class="horizon-intro">
          <p>
            Travel further. Find your direction.
            <br />
            Make your next chapter meaningful.
          </p>
          <a class="button" href="#booking">
            Find your next step <Arrow />
          </a>
        </div>
      </div>
      <figure class="horizon-landscape">
        <img
          src="/images/coast.webp"
          srcset="/images/coast-small.webp 768w, /images/coast.webp 1536w"
          sizes="100vw"
          width="1536"
          height="1024"
          alt="An imagined quiet coastline, with warm sand and blue ocean"
          fetchpriority="high"
        />
        <div class="landscape-label">
          <span>
            Less logistics.
            <br />
            More living.
          </span>
          <a href="#services" aria-label="Explore our services">
            ↓
          </a>
        </div>
        <figcaption>Coastal study · Original digital artwork</figcaption>
      </figure>
    </section>
    <section class="horizon-about section wrap" id="about">
      <span class="eyebrow">A bigger picture of life</span>
      <h2>
        Your plans are connected.
        <br />
        <span>Your support can be, too.</span>
      </h2>
      <div class="horizon-about-bottom">
        <span class="horizon-sun" aria-hidden="true">
          ↗
        </span>
        <div>
          <p class="lead">{business.about}</p>
          <p>{business.mission}</p>
        </div>
        <p class="side-note">
          For veterans.
          <br />
          For transitions.
          <br />
          For the possibilities
          <br />
          ahead.
        </p>
      </div>
    </section>
    <Portrait />
    <Services theme="horizon" />
    <section class="horizon-statement wrap">
      <p>
        A new place.
        <br />A new perspective.
        <br />
        <span>
          The same you,
          <br />
          with more possibility.
        </span>
      </p>
      <a class="button" href="#booking">
        Let’s explore it <Arrow />
      </a>
    </section>
    <SharedSections theme="horizon" />
  </main>
</Base>
