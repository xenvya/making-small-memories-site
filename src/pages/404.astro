---
import Base from "../layouts/Base.astro";
import Brand from "../components/Brand.astro";
---

<Base title="Let’s find your way" robots="noindex, follow">
  <main id="main" class="legal wrap">
    <a class="wordmark" href="/" aria-label="Making Small Memories home">
      <Brand />
    </a>
    <h1>A small detour.</h1>
    <p>That page could not be found. Let’s help you find your way home.</p>
    <p>
      <a class="button" href="/">
        Back to the homepage →
      </a>
    </p>
  </main>
</Base>
