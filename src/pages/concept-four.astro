---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Arrow from "../components/Arrow.astro";
import LineIcon from "../components/LineIcon.astro";
import Services from "../components/Services.astro";
import SharedSections from "../components/SharedSections.astro";
import { business, services } from "../data/business";
import "@fontsource/cormorant-garamond/latin-400.css";
import "@fontsource/cormorant-garamond/latin-400-italic.css";
import "../styles/chapter.css";
---

<Base title="Golden Hour" theme="chapter">
  <Header theme="chapter" />
  <main id="main">
    <section class="golden-hero wrap">
      <div class="golden-hero-copy">
        <span class="eyebrow">
          <span class="golden-dot"></span> A life made of meaningful moments
        </span>
        <h1>
          Some moments
          <br />
          change
          <br />
          <em>everything.</em>
        </h1>
        <p>
          The places you discover. The people beside you.
          <br />
          The life you choose to make your own.
        </p>
        <div class="golden-actions">
          <a class="button" href="#booking">
            Make your next moment <Arrow />
          </a>
          <a href="#directions" class="golden-explore">
            Explore the possibilities ↓
          </a>
        </div>
      </div>
      <div class="golden-portrait-stage" data-depth>
        <svg class="orbital-art" viewBox="0 0 700 800" aria-hidden="true">
          <ellipse
            cx="350"
            cy="395"
            rx="307"
            ry="362"
            fill="none"
            stroke="currentColor"
            stroke-width=".8"
          />
          <ellipse
            cx="350"
            cy="395"
            rx="273"
            ry="330"
            fill="none"
            stroke="currentColor"
            stroke-width=".6"
            stroke-dasharray="2 8"
          />
          <path
            d="M40 525C150 780 580 720 660 220"
            fill="none"
            stroke="currentColor"
            stroke-width=".8"
          />
          <g class="orbital-star">
            <path
              d="M610 165v50m-25-25h50m-42-17 34 34m0-34-34 34"
              stroke="currentColor"
              stroke-width="1.4"
            />
          </g>
          <circle cx="93" cy="610" r="6" fill="currentColor" />
        </svg>
        <figure class="golden-portrait">
          <img
            src="/images/john-and-wife.webp"
            srcset="/images/john-and-wife-small.webp 600w, /images/john-and-wife.webp 1118w"
            sizes="(max-width:700px) 90vw, 45vw"
            width="1118"
            height="1118"
            alt="John C. Small Jr. and his wife, dressed for a special occasion"
            fetchpriority="high"
          />
          <figcaption>John C. Small Jr. & his wife</figcaption>
        </figure>
        <div class="golden-seal">
          <svg viewBox="0 0 120 120" aria-hidden="true">
            <path id="seal-circle" d="M60 12a48 48 0 1 1-.1 0" fill="none" />
            <text>
              <textPath href="#seal-circle">
                SMALL MOMENTS · LASTING MEANING ·{" "}
              </textPath>
            </text>
            <path
              d="M60 39v42M39 60h42M45 45l30 30m0-30L45 75"
              stroke="currentColor"
            />
          </svg>
        </div>
        <span class="portrait-side-note">Life is better, shared.</span>
      </div>
      <div class="golden-hero-foot">
        <span>TRAVEL · TRANSITION · RETIREMENT · POSSIBILITY</span>
        <a href="#about">
          Stay a little. Discover more. <span aria-hidden="true">↓</span>
        </a>
      </div>
    </section>
    <section class="golden-purpose section wrap" id="about">
      <span class="eyebrow">The heart of Making Small Memories</span>
      <h2>
        Not every moment is big.
        <br />
        <em>Every one can matter.</em>
      </h2>
      <div class="golden-purpose-grid">
        <svg
          class="golden-sun"
          viewBox="0 0 200 200"
          fill="none"
          aria-hidden="true"
        >
          <circle cx="100" cy="100" r="42" stroke="currentColor" />
          {Array.from({ length: 24 }, (_, i) => (
            <path
              d="M100 12v31"
              stroke="currentColor"
              transform={`rotate(${i * 15} 100 100)`}
            />
          ))}
        </svg>
        <p class="lead">{business.mission}</p>
        <p>{business.about}</p>
      </div>
    </section>
    <section id="directions" class="golden-directions section">
      <div class="wrap">
        <span class="eyebrow">There is more than one way forward</span>
        <div class="direction-heading">
          <h2>
            What are you
            <br />
            <em>making room for?</em>
          </h2>
          <p>
            Follow your curiosity. Choose a direction
            <br />
            and see where the conversation could begin.
          </p>
        </div>
        <div
          class="direction-controls"
          role="group"
          aria-label="Choose a life direction"
        >
          {services.map((s, i) => (
            <button
              data-direction={i}
              aria-pressed={i === 0 ? "true" : "false"}
            >
              <LineIcon kind={s.id} />
              <span>{s.category}</span>
              <span aria-hidden="true">↗</span>
            </button>
          ))}
        </div>
        <div class="direction-feature">
          <span class="direction-counter" aria-hidden="true">
            01
          </span>
          <div aria-live="polite" aria-atomic="true">
            <span class="eyebrow" data-direction-label>
              {services[0].label}
            </span>
            <h3 data-direction-title>{services[0].short}</h3>
            <p data-direction-description>{services[0].description}</p>
          </div>
          <a
            class="button"
            href="#booking"
            data-direction-cta
            data-interest={services[0].label}
          >
            Begin here <Arrow />
          </a>
        </div>
      </div>
    </section>
    <Services theme="chapter" />
    <section class="golden-interlude">
      <svg viewBox="0 0 1400 280" preserveAspectRatio="none" aria-hidden="true">
        <path
          d="M-30 190C270-170 1050 510 1450 80M-30 210C270-150 1050 530 1450 100M-30 170C270-190 1050 490 1450 60"
          fill="none"
          stroke="currentColor"
          stroke-width=".6"
        />
      </svg>
      <span class="eyebrow">One small memory at a time.</span>
      <p>
        A little more living.
        <br />
        <em>A little more you.</em>
      </p>
    </section>
    <SharedSections theme="chapter" />
  </main>
</Base>
