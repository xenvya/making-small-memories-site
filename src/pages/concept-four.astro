---
import chapterFont from "@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Art from "../components/Art.astro";
import Arrow from "../components/Arrow.astro";
import Services from "../components/Services.astro";
import SharedSections from "../components/SharedSections.astro";
import { business } from "../data/business";
import "@fontsource/space-grotesk/latin-400.css";
import "@fontsource/space-grotesk/latin-700.css";
import "../styles/chapter.css";
---

<Base title="The Next Chapter" theme="chapter">
  <link
    slot="head"
    rel="preload"
    href={chapterFont}
    as="font"
    type="font/woff2"
    crossorigin
  />
  <Header theme="chapter" />
  <main id="main">
    <section class="chapter-hero wrap">
      <div class="chapter-kicker">
        <span class="eyebrow">Big life. Small moments.</span>
        <span>YOUR NEXT CHAPTER STARTS HERE ↙</span>
      </div>
      <h1>
        Make room
        <br />
        for{" "}
        <span>
          what
          <br /> matters.
        </span>
      </h1>
      <div class="chapter-hero-bottom">
        <span class="chapter-asterisk" aria-hidden="true">
          ✳
        </span>
        <p>
          More connection. More intention.
          <br />
          Thoughtful support for the life
          <br />
          you want to live.
        </p>
        <a class="button" href="#booking">
          Let’s talk about what’s next <Arrow />
        </a>
      </div>
    </section>
    <section class="chapter-about" id="about">
      <div class="chapter-about-title">
        <span class="eyebrow">A life beyond the to-do list</span>
        <h2>
          You’re more
          <br />
          than your
          <br />
          <em>next plan.</em>
        </h2>
        <Art kind="arch" />
      </div>
      <div class="chapter-about-copy">
        <span class="eyebrow">Making Small Memories</span>
        <p class="lead">{business.vision}</p>
        <p>{business.mission}</p>
        <p>{business.about}</p>
        <a class="text-link" href="#services">
          Find your way in <Arrow />
        </a>
      </div>
    </section>
    <Services theme="chapter" />
    <section class="chapter-manifesto wrap">
      <span class="eyebrow">Keep this in mind.</span>
      <p>
        Slow down.
        <br />
        Connect.
        <br />
        <span>Make a memory.</span>
      </p>
    </section>
    <SharedSections theme="chapter" />
  </main>
</Base>
