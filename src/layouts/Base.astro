---
import "@fontsource/dm-sans/latin-400.css";
import "@fontsource/dm-sans/latin-500.css";
import "@fontsource/dm-sans/latin-700.css";
import "../styles/global.css";
import "../styles/brand.css";
import "../styles/experiences.css";
import { business } from "../data/business";
interface Props {
  title: string;
  description?: string;
  theme?: string;
  robots?: string;
}
const {
  title,
  description = "Thoughtful travel, life coaching, VA benefits guidance, retirement planning, and investment education. Make room for what matters with Making Small Memories.",
  theme = "gallery",
  robots = "index, follow",
} = Astro.props;
const canonicalPath = Astro.url.pathname
  .replace(/\/index\.html$/, "/")
  .replace(/\.html$/, "");
const canonical = new URL(canonicalPath, Astro.site);
const documentTitle =
  title === business.name ? title : `${title} | ${business.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f0e8" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="192x192" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL("/images/social.jpg", Astro.site)}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: business.legalName,
        email: business.email,
        telephone: business.tel,
        url: Astro.site,
      })}
    ></script>
    <script is:inline>
      document.documentElement.classList.add("js");
      if (
        window.location.hostname ===
        "making-small-memories-concepts.xenvya.workers.dev"
      ) {
        document.documentElement.classList.add("concept-preview");
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", "#f4f7fa");
      }
    </script>
    <noscript>
      <style>
        .service-panel[hidden] {
          display: grid !important;
        }
        .service-tabs {
          display: none !important;
        }
        .site-header nav {
          display: flex !important;
        }
        .menu-toggle {
          display: none !important;
        }
      </style>
    </noscript>
    <slot name="head" />
  </head>
  <body class={theme}>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <aside class="concept-notice" aria-label="Concept site notice">
      <span>Concept preview</span>
      <a
        href="https://www.makingsmallmemories.com"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visit the live website (opens in a new tab)"
      >
        Visit the live website <span aria-hidden="true">↗</span>
      </a>
    </aside>
    <slot />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
