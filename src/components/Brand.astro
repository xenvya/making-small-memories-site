---
interface Props {
  markOnly?: boolean;
}

const { markOnly = false } = Astro.props;
const src = markOnly
  ? "/brand/msm-signature-serif-mark.png"
  : "/brand/msm-signature-serif.png";
const width = 1075;
const height = markOnly ? 428 : 564;
---

<span class:list={["brand-lockup", { "brand-lockup--mark": markOnly }]}>
  <img
    class="brand-signature"
    src={src}
    srcset={
      markOnly
        ? undefined
        : "/brand/msm-signature-serif-small.png 540w, /brand/msm-signature-serif.png 1075w"
    }
    sizes={markOnly ? undefined : "(max-width: 700px) 142px, 176px"}
    width={width}
    height={height}
    alt=""
    decoding="async"
  />
</span>
