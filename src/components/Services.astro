---
import { services, type Theme } from "../data/business";
import Arrow from "./Arrow.astro";
import LineIcon from "./LineIcon.astro";
interface Props {
  theme: Theme;
}
const { theme } = Astro.props;
---

<section
  id="services"
  class={`services section wrap services-${theme}`}
  aria-labelledby="services-title"
>
  <div class="section-heading">
    <span class="eyebrow">
      {theme === "fieldnotes"
        ? "02 / The field guide"
        : "Thoughtful support, in five directions"}
    </span>
    <h2 id="services-title">
      {theme === "horizon"
        ? "Where do you want to go?"
        : theme === "chapter"
          ? "A fuller life.\nFive ways in."
          : theme === "fieldnotes"
            ? "Find your way forward."
            : "Big changes.\nSmall, thoughtful steps."}
    </h2>
    <p>
      Life rarely fits into one category. Find support for the part you’re
      navigating now.
    </p>
  </div>
  {theme === "horizon" ? (
    <div class="service-explorer" data-explorer>
      <div
        class="service-tabs"
        role="tablist"
        aria-label="Explore our services"
      >
        {services.map((s, i) => (
          <button
            id={`tab-${s.id}`}
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
            aria-controls={`panel-${s.id}`}
            tabindex={i === 0 ? 0 : -1}
          >
            {s.category}
            <span aria-hidden="true">↗</span>
          </button>
        ))}
      </div>
      {services.map((s, i) => (
        <article
          id={`panel-${s.id}`}
          class="service-panel"
          role="tabpanel"
          aria-labelledby={`tab-${s.id}`}
          tabindex="0"
          hidden={i !== 0}
        >
          <div class="panel-number" aria-hidden="true">
            0{i + 1}
          </div>
          <div>
            <LineIcon kind={s.id} />
            <span class="eyebrow">{s.label}</span>
            <h3>{s.short}</h3>
            <p>{s.description}</p>
            <ul>
              {s.details.map((d) => (
                <li>{d}</li>
              ))}
            </ul>
            <a class="text-link" href="#booking" data-interest={s.label}>
              Let’s talk about this <Arrow />
            </a>
          </div>
        </article>
      ))}
    </div>
  ) : theme === "fieldnotes" ? (
    <div class="field-guide">
      <nav class="guide-index" aria-label="Service guide">
        {services.map((s, i) => (
          <a href={`service-${s.id}`.replace(/^/, "#")} data-guide-link>
            <span>0{i + 1}</span>
            {s.label}
          </a>
        ))}
      </nav>
      <div>
        {services.map((s, i) => (
          <article id={`service-${s.id}`} class="guide-entry">
            <span class="eyebrow">
              Route 0{i + 1} / {s.category}
            </span>
            <LineIcon kind={s.id} />
            <h3>{s.label}</h3>
            <p class="service-lead">{s.short}</p>
            <p>{s.description}</p>
            <ul>
              {s.details.map((d) => (
                <li>{d}</li>
              ))}
            </ul>
            <a class="text-link" href="#booking" data-interest={s.label}>
              Explore this direction <Arrow />
            </a>
          </article>
        ))}
      </div>
    </div>
  ) : (
    <div class="service-rows">
      {services.map((s, i) => (
        <article class="service-row">
          <span class="service-no">0{i + 1}</span>
          <div class="service-title">
            <LineIcon kind={s.id} />
            <span class="eyebrow">{s.category}</span>
            <h3>{s.label}</h3>
          </div>
          <div class="service-copy">
            <p>{s.description}</p>
            <details>
              <summary>
                What we can explore <span aria-hidden="true">+</span>
              </summary>
              <ul>
                {s.details.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            </details>
          </div>
          <a
            class="round-link"
            href="#booking"
            data-interest={s.label}
            aria-label={`Discuss ${s.label}`}
          >
            <Arrow />
          </a>
        </article>
      ))}
    </div>
  )}
</section>
