---
import { services } from "../data/business";
import Arrow from "./Arrow.astro";
import LineIcon from "./LineIcon.astro";
---

<section
  id="services"
  class="services section wrap services-keepsake"
  aria-labelledby="services-title"
>
  <div class="section-heading">
    <span class="eyebrow">Thoughtful support, in five directions</span>
    <h2 id="services-title">
      Big changes.
      <br />
      Small, thoughtful steps.
    </h2>
    <p>
      Life rarely fits into one category. Find support for the part you’re
      navigating now.
    </p>
  </div>
  <div class="service-rows">
    {services.map((service, index) => (
      <article class="service-row">
        <span class="service-no">0{index + 1}</span>
        <div class="service-title">
          <LineIcon kind={service.id} />
          <span class="eyebrow">{service.category}</span>
          <h3>{service.label}</h3>
        </div>
        <div class="service-copy">
          <p>{service.description}</p>
          {service.resource && (
            <a
              class="service-resource"
              href={service.resource.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${service.resource.label} (opens in a new tab)`}
            >
              {service.resource.label} <span aria-hidden="true">↗</span>
            </a>
          )}
          <details>
            <summary>
              What we can explore <span aria-hidden="true">+</span>
            </summary>
            <ul>
              {service.details.map((detail) => (
                <li>{detail}</li>
              ))}
            </ul>
          </details>
        </div>
        <a
          class="round-link"
          href="#booking"
          data-interest={service.label}
          aria-label={`Discuss ${service.label}`}
        >
          <Arrow />
        </a>
      </article>
    ))}
  </div>
</section>
