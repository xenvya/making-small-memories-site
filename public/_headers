/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://app.cal.com https://cal.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.cal.com; font-src 'self'; frame-src https://cal.com https://app.cal.com; connect-src 'self' https://cal.com https://app.cal.com https://*.cal.com; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'self'
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
